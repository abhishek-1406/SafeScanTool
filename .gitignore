# ─────────────────────────────────────────
# SafeScan .gitignore
# ─────────────────────────────────────────

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
venv/
env/
.env/
.venv/
vendor/          # pip --target dir used for the sandboxed preview server

# Environment variables & API keys — NEVER commit these
.env
*.env
secrets.json
google_credentials.json

# Jupyter Notebooks — checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# Large model files — too big for GitHub (store on Google Drive / HuggingFace Hub)
*.pkl
*.h5
*.pt
*.pth
*.bin
*.ckpt
*.safetensors
*.keras
models/bert/
backend/models/*.pkl
backend/models/*.h5
backend/models/*.pt

# Raw datasets — do not upload (see data/README.md for access instructions)
data/hatexplain/
data/davidson/
data/hateful_memes/
*.csv
*.json
*.jsonl

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDEs
.vscode/
.idea/
*.swp
*.swo

# Node / Frontend
node_modules/
.next/
frontend/.next/
frontend/node_modules/
npm-debug.log*

# Logs
*.log
logs/

# Coverage & testing
.coverage
htmlcov/
.pytest_cache/
