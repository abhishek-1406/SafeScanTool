# ─────────────────────────────────────────────────────────────
# SafeScan configuration — copy to `.env` and adjust as needed.
#   cp .env.example .env
# NOTHING SECRET IS REQUIRED to run the core app. The optional API keys
# below are only for the legacy notebook OCR paths. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────

# --- Flask runtime ---
HOST=0.0.0.0
PORT=5000
# Set to 1 for auto-reload during development.
FLASK_DEBUG=0
# Max meme upload size (MB).
MAX_UPLOAD_MB=8

# --- Model & data paths (defaults point at ./models and ./Data) ---
MODELS_DIR=models
DATA_PATH=Data/updated_hatexplain_data.csv
SVM_MODEL_PATH=models/svm_model.pkl
SVM_VECTORIZER_PATH=models/svm_vectorizer.pkl
BERT_MODEL_DIR=models/bert
METRICS_PATH=models/metrics.json
FAIRNESS_PATH=models/fairness.json

# HF model repo the Docker build pulls trained weights from (see docs/DEPLOYMENT.md).
MODELS_REPO_ID=casanovaabhishek14/safescan-models

# --- Bi-LSTM training (optional) ---
# Path to GloVe vectors; if unset/missing, a trainable embedding layer is used.
# GLOVE_PATH=/path/to/glove.6B.100d.txt

# --- Legacy notebook OCR providers (OPTIONAL — not used by app.py) ---
# The default meme pipeline uses local pytesseract and needs no keys.
# These only matter if you re-run the old Google-Vision / Clarifai notebook paths.
# Rotate/keep these secret — do not paste real values into version control.
GOOGLE_VISION_API_KEY=
CLARIFAI_PAT=
NGROK_AUTHTOKEN=
